# ============================================
# FinalStock 环境变量配置
# 复制此文件为 .env 并修改配置
# ============================================

# 服务器端口
PORT=3000

# 数据库配置（本地部署使用 localhost，Docker 部署使用容器服务名）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=openclaw
DB_USER=openclaw
DB_PASSWORD=ocoper

# Docker 部署时数据库 root 密码（仅 docker-compose 使用）
MYSQL_ROOT_PASSWORD=your_root_password_here

# 大模型配置（默认使用硅基流动，也支持通义千问、文心一言等）
# 可在系统设置页面动态修改，修改后无需重启
LLM_PROVIDER=siliconflow
LLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# JWT 密钥（预留，当前版本未启用认证）
# 生产环境请修改为随机字符串：openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# 运行环境（development 会打印 SQL 日志，production 关闭）
NODE_ENV=production

# 日志级别（debug/info/warn/error）
LOG_LEVEL=info

# 新闻同步配置（也可在系统设置页面修改，实时生效）
NEWS_SYNC_ENABLED=1          # 1=开启，0=关闭
NEWS_SYNC_PERIOD_TYPE=hour   # 周期类型：second/minute/hour/day/week/month
NEWS_SYNC_PERIOD_VALUE=6     # 周期数值，与 PERIOD_TYPE 组合使用（此处=每6小时）
NEWS_RETENTION_DAYS=7        # 新闻保留天数，超期自动清理
