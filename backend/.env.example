# ============================================
# FinalStock 环境变量配置
# 复制此文件为 .env 并修改配置
# ============================================

# 服务器端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=openclaw
DB_USER=openclaw
DB_PASSWORD=ocoper

# Docker 部署时数据库 root 密码
MYSQL_ROOT_PASSWORD=your_root_password_here

# LLM 配置 (SiliconFlow)
LLM_PROVIDER=siliconflow
LLM_API_URL=https://api.siliconflow.cn/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# JWT 密钥 (请修改为随机字符串)
JWT_SECRET=your_jwt_secret_key_here

# 环境模式
NODE_ENV=production

# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info

# 新闻同步配置
NEWS_SYNC_ENABLED=1
NEWS_SYNC_PERIOD_TYPE=hour
NEWS_SYNC_PERIOD_VALUE=6
NEWS_RETENTION_DAYS=7